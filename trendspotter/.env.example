# Copy to .env for local runs (never commit .env). In GitHub, add these as
# repository secrets: Settings > Secrets and variables > Actions.
ANTHROPIC_API_KEY=
# Gmail: create an app password at https://myaccount.google.com/apppasswords (needs 2-step verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
EMAIL_TO=you@gmail.com
EMAIL_FROM=you@gmail.com
# Optional
TRENDSPOTTER_MODEL=claude-opus-5-5
TRENDSPOTTER_EFFORT=medium
